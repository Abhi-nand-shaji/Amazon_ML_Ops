# --- challenge-provided material (download it from the challenge; not redistributed here) ---
dataset/
utils/
PROBLEM_STATEMENT.md
.DS_Store

# --- environments and caches ---
.venv/
venv/
__pycache__/
*.pyc
*.tmp

# --- pipeline intermediates: regenerated by run_all.py (normalized caches, shortlists, candidates, features,
#     scores: several GB) and run logs ---
code/business_entity_resolution/artifacts/cache/
code/business_entity_resolution/artifacts/logs/
code/business_entity_resolution/artifacts/*.parquet

# --- raw submission files are committed gzip-compressed instead (GitHub rejects files over 100 MB) ---
output/*.tsv

# --- final submission archive (rebuilt with make_submission_zip.py) ---
submission/
